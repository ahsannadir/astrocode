{
  "name": "astrocode",
  "version": "1.3.0",
  "description": "AstroCode — a fast terminal coding agent: 16 tools, sub-agents, and swarm mode, on exactly two dependencies.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "astrocode": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.8"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "probe": "npm run build && python3 scripts/run_probes.py",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "link": "npm run build && npm link && npm unlink -g astro 2>/dev/null; true"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "tui",
    "terminal",
    "coding-agent",
    "llm"
  ],
  "license": "MIT",
  "dependencies": {
    "ink": "^5.0.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
